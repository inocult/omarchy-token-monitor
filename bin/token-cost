#!/usr/bin/python3
"""What today actually cost, in dollars.

  token-cost                 rate the transcripts, write the sidecar
  token-cost --print         write nothing, dump the record to stdout
  token-cost --update-rates  refresh the rate table from LiteLLM
  token-cost --rates         show the table in use and where it came from

WHY THIS EXISTS AT ALL. Omarchy's agents panel reads one record per agent from
~/.local/state/omarchy/agents/usage/, written by the first-party collectors in
$OMARCHY_PATH/bin. Those records carry tokens and no cost. That is a deliberate
gap, not an oversight -- a rate table is display metadata that goes stale, and
collection is not the place for it.

So cost is computed here, beside those records rather than inside them:

  ~/.local/state/omarchy/agents/usage/       first-party, we never write here
  ~/.local/state/omarchy/agents/usage-cost/  ours

usage-cost/, NOT usage/. Anything that appears in usage/ is taken by the panel
to be a whole new agent, so a cost file dropped in there would show up in the
bar as a subscription called "cost". It would also be destroyed on the next
tick: omarchy-agent-usage-update mv's over usage/<agent>.json every run.

WHY IT RE-SCANS THE TRANSCRIPTS INSTEAD OF READING THE RECORD. This is the part
worth understanding before "simplifying" it. The record's modelUsage is split
four ways -- input, output, cache write, cache read -- but it is ALL-TIME. The
per-day numbers in recentDays are a single scalar each:

    recentDays: [{ date: "2026-09-10", messageCount: 55037669 }]

and despite the name, messageCount is a token total (the first-party collector
says so in a comment). There is no per-day split anywhere in the record.

That would be fine if the four categories cost the same. They differ by 50x:
output is $25/M on Opus 5, cache read is $0.50/M. And the mix is extreme --
measured on this machine, cache reads are 97.7% of the tokens and 63% of the
cost, while output is 0.8% of the tokens and 24% of the cost. Pro-rating a day
by its token share happens to land within ~2% while the daily mix stays stable,
and silently stops being true the day it does not. An hour of long-context
reading and an hour of code generation are the same token count and nowhere
near the same bill.

All-time cost IS exactly computable from the record, and if that were the only
number wanted this script would not need to exist. The headline is "today".

The scan itself is deliberately the same shape as
$OMARCHY_PATH/bin/omarchy-agent-usage-claude: same files, same assistant-message
filter, same dedup on message.id, same timestamp-to-local-date rule. Two passes
over the same data that disagreed about what a day is would be worse than no
cost at all, so where this differs from that collector, that collector is right
and this is the bug.

RATES. USD per million tokens, four independent rates per model, applied as a
plain dot product -- cache reads and cache writes are not derived from the
input rate, they are their own line items. The built-in table below was checked
against LiteLLM, models.dev and OpenRouter on 2026-09-11 and all three agreed.
--update-rates refreshes it from LiteLLM into

  ~/.config/omarchy/token-monitor/rates.json

which wins over the built-in table when present. Nothing fetches anything at
render time: the panel reads the sidecar, the sidecar is written here, and here
only talks to the network when asked to.

A model with no rate produces no cost rather than a wrong one -- the row is
reported with costUsd null and counted in `unrated`, so the panel can say "3
models unpriced" instead of quietly under-reporting the bill.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import tempfile
import urllib.request
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 1
AGENT_ID = "claude"

# USD per 1,000,000 tokens: input, output, cache write (5-minute), cache read.
# None means the provider does not bill that category at all -- OpenAI creates
# cached input for free -- which is not the same as "rate unknown", and is only
# ever reached when the category has tokens to bill.
RATES_AS_OF = "2026-09-11"
BUILTIN_RATES: dict[str, dict[str, float | None]] = {
    # Anthropic
    "claude-opus-5": {"input": 5.00, "output": 25.00, "cacheWrite": 6.25, "cacheRead": 0.50},
    "claude-opus-4-5": {"input": 5.00, "output": 25.00, "cacheWrite": 6.25, "cacheRead": 0.50},
    "claude-sonnet-5": {"input": 2.00, "output": 10.00, "cacheWrite": 2.50, "cacheRead": 0.20},
    "claude-haiku-4-5": {"input": 1.00, "output": 5.00, "cacheWrite": 1.25, "cacheRead": 0.10},
    "claude-fable-5": {"input": 10.00, "output": 50.00, "cacheWrite": 12.50, "cacheRead": 1.00},
    "claude-fable-5-1": {"input": 10.00, "output": 50.00, "cacheWrite": 12.50, "cacheRead": 0.25},
    # OpenAI / Codex. cacheWrite is None on purpose: cached input is created
    # free, so a rate here would invent a charge that is not on the invoice.
    "gpt-5.5": {"input": 5.00, "output": 30.00, "cacheWrite": None, "cacheRead": 0.50},
    "gpt-5.3-codex": {"input": 1.75, "output": 14.00, "cacheWrite": None, "cacheRead": 0.175},
    "gpt-5.2-codex": {"input": 1.75, "output": 14.00, "cacheWrite": None, "cacheRead": 0.175},
    "gpt-5.2": {"input": 1.75, "output": 14.00, "cacheWrite": None, "cacheRead": 0.175},
    "gpt-5.1-codex-max": {"input": 1.25, "output": 10.00, "cacheWrite": None, "cacheRead": 0.125},
    "gpt-5.1-codex": {"input": 1.25, "output": 10.00, "cacheWrite": None, "cacheRead": 0.125},
    "gpt-5.1-codex-mini": {"input": 0.25, "output": 2.00, "cacheWrite": None, "cacheRead": 0.025},
    "gpt-5.1": {"input": 1.25, "output": 10.00, "cacheWrite": None, "cacheRead": 0.125},
    "gpt-5": {"input": 1.25, "output": 10.00, "cacheWrite": None, "cacheRead": 0.125},
    "gpt-5-codex": {"input": 1.25, "output": 10.00, "cacheWrite": None, "cacheRead": 0.125},
    "gpt-5-mini": {"input": 0.25, "output": 2.00, "cacheWrite": None, "cacheRead": 0.025},
    "gpt-5-nano": {"input": 0.05, "output": 0.40, "cacheWrite": None, "cacheRead": 0.005},
    "codex-mini-latest": {"input": 1.50, "output": 6.00, "cacheWrite": None, "cacheRead": 0.375},
}

LITELLM_URL = "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
LITELLM_FIELDS = {
    "input": "input_cost_per_token",
    "output": "output_cost_per_token",
    "cacheWrite": "cache_creation_input_token_cost",
    "cacheRead": "cache_read_input_token_cost",
}

CATEGORIES = ("input", "output", "cacheWrite", "cacheRead")


# ---------------------------------------------------------------- locations


def expand(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value)))


def claude_dir() -> Path:
    return expand(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")


def state_dir() -> Path:
    root = expand(os.environ.get("XDG_STATE_HOME") or "~/.local/state")
    return root / "omarchy" / "agents" / "usage-cost"


def rates_file() -> Path:
    root = expand(os.environ.get("XDG_CONFIG_HOME") or "~/.config")
    return root / "omarchy" / "token-monitor" / "rates.json"


# -------------------------------------------------------------------- rates


def load_rates() -> tuple[dict[str, dict[str, float | None]], str, str]:
    """Table, where it came from, and the date it was true."""
    path = rates_file()
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
        table = doc.get("rates")
        if isinstance(table, dict) and table:
            merged = dict(BUILTIN_RATES)
            # A refreshed table adds to the built-ins rather than replacing
            # them: a model upstream has not heard of should keep its known
            # rate instead of going unpriced after an --update-rates.
            for model, rates in table.items():
                if isinstance(rates, dict):
                    merged[str(model).strip().lower()] = rates
            return merged, str(path), str(doc.get("ratesAsOf") or "unknown")
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as error:
        print(f"token-cost: ignoring {path}: {error}", file=sys.stderr)
    return dict(BUILTIN_RATES), "built-in", RATES_AS_OF


def update_rates() -> int:
    """Refresh the known models' rates from LiteLLM.

    Only the models already in the built-in table are pulled. The upstream file
    is 2.3MB of 3900 models; carrying all of it would mean shipping a catalogue
    and a cache-invalidation problem to price the two or three models this desk
    actually runs.
    """
    try:
        with urllib.request.urlopen(LITELLM_URL, timeout=30) as response:
            catalog = json.loads(response.read().decode("utf-8"))
    except Exception as error:  # noqa: BLE001 - any failure means keep the old table
        print(f"token-cost: rate refresh failed: {error}", file=sys.stderr)
        return 1

    refreshed: dict[str, dict[str, float | None]] = {}
    missing: list[str] = []
    for model in BUILTIN_RATES:
        entry = catalog.get(model)
        if not isinstance(entry, dict):
            missing.append(model)
            continue
        rates: dict[str, float | None] = {}
        for category, field in LITELLM_FIELDS.items():
            value = entry.get(field)
            # Per-token upstream, per-million here, so the file stays readable
            # by a human who wants to check a number against a price page.
            rates[category] = round(float(value) * 1_000_000, 6) if isinstance(value, (int, float)) else None
        refreshed[model] = rates

    path = rates_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json(path, {
        "ratesAsOf": dt.date.today().isoformat(),
        "source": LITELLM_URL,
        "rates": refreshed,
    })
    print(f"token-cost: refreshed {len(refreshed)} models into {path}")
    if missing:
        print(f"token-cost: not in upstream, keeping built-in rates: {', '.join(sorted(missing))}")
    return 0


def normalized_model(value: Any) -> str:
    """`claude-opus-5[1m]` and `claude-opus-5` are the same price.

    Claude Code tags the 1M-context variant with a bracketed suffix. Anthropic
    publishes no long-context surcharge for Opus 5 (LiteLLM's
    input_cost_per_token_above_200k_tokens is null), so the suffix is a context
    window, not a price tier, and dropping it prices the row correctly instead
    of leaving it unrated.
    """
    model = str(value or "").strip().lower()
    if model.endswith("]") and "[" in model:
        model = model[: model.rindex("[")]
    return model.strip()


def cost_of(tokens: dict[str, int], rates: dict[str, float | None] | None) -> float | None:
    """Four categories, four rates, one dot product.

    None rather than a partial sum when a category with tokens has no rate: an
    under-reported bill that looks precise is worse than an admitted gap.
    """
    if not rates:
        return None
    total = 0.0
    for category in CATEGORIES:
        count = tokens.get(category, 0)
        if not count:
            continue
        rate = rates.get(category)
        if rate is None or not isinstance(rate, (int, float)) or rate < 0:
            return None
        total += count * float(rate) / 1_000_000
    return round(total, 6)


# ----------------------------------------------------------------- scanning


def local_date(value: Any) -> str:
    """Kept deliberately identical to the first-party collector's rule."""
    if isinstance(value, (int, float)):
        seconds = float(value)
        if seconds > 1e11:  # milliseconds
            seconds /= 1000.0
        return dt.datetime.fromtimestamp(seconds).date().isoformat()
    text = str(value or "").strip()
    if not text:
        return ""
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError:
        return ""
    if parsed.tzinfo is not None:
        parsed = parsed.astimezone()
    return parsed.date().isoformat()


def token_count(usage: dict[str, Any], snake: str, camel: str) -> int:
    value = usage.get(snake, usage.get(camel, 0))
    try:
        number = int(value)
    except (TypeError, ValueError):
        return 0
    return max(0, number)


def empty() -> dict[str, int]:
    return {category: 0 for category in CATEGORIES}


def add(into: dict[str, int], other: dict[str, int]) -> None:
    for category in CATEGORIES:
        into[category] += other[category]


def scan() -> dict[str, dict[str, dict[str, int]]]:
    """{day: {model: {input, output, cacheWrite, cacheRead}}}"""
    projects = claude_dir() / "projects"
    by_day: dict[str, dict[str, dict[str, int]]] = {}
    seen: set[str] = set()

    files = sorted(projects.rglob("*.jsonl")) if projects.is_dir() else []
    for path in files:
        try:
            handle = path.open("r", encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for line_number, line in enumerate(handle):
                # Cheap reject first: most transcript lines are user turns and
                # tool results, and parsing them all is the whole runtime.
                if '"usage":' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(entry, dict):
                    continue
                message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
                if entry.get("type") != "assistant" and message.get("role") != "assistant":
                    continue
                usage = message.get("usage") or entry.get("usage")
                if not isinstance(usage, dict):
                    continue

                # One assistant message can appear in several transcripts after
                # a resume or a fork; billed once.
                message_id = message.get("id") or entry.get("messageId") or ""
                key = str(message_id) if message_id else f"{path}:{entry.get('uuid') or entry.get('requestId') or line_number}"
                if key in seen:
                    continue
                seen.add(key)

                tokens = {
                    "input": token_count(usage, "input_tokens", "inputTokens"),
                    "output": token_count(usage, "output_tokens", "outputTokens"),
                    "cacheRead": token_count(usage, "cache_read_input_tokens", "cacheReadInputTokens"),
                    "cacheWrite": token_count(usage, "cache_creation_input_tokens", "cacheCreationInputTokens"),
                }
                if not any(tokens.values()):
                    continue

                day = local_date(entry.get("timestamp") or message.get("timestamp"))
                if not day:
                    continue
                model = normalized_model(message.get("model") or entry.get("model") or "claude")
                bucket = by_day.setdefault(day, {}).setdefault(model, empty())
                add(bucket, tokens)

    return by_day


# ------------------------------------------------------------------ record


def build_record(by_day: dict[str, dict[str, dict[str, int]]], rates: dict[str, dict[str, float | None]],
                 rates_source: str, rates_as_of: str) -> dict[str, Any]:
    days: dict[str, Any] = {}
    all_time = empty()
    all_time_models: dict[str, dict[str, int]] = {}
    unrated: set[str] = set()

    for day in sorted(by_day):
        models_out: dict[str, Any] = {}
        day_tokens = empty()
        day_cost = 0.0
        day_priced = True

        for model in sorted(by_day[day]):
            tokens = by_day[day][model]
            model_cost = cost_of(tokens, rates.get(model))
            if model_cost is None:
                unrated.add(model)
                day_priced = False
            else:
                day_cost += model_cost
            models_out[model] = {**tokens, "tokens": sum(tokens.values()), "costUsd": model_cost}
            add(day_tokens, tokens)
            add(all_time_models.setdefault(model, empty()), tokens)

        add(all_time, day_tokens)
        days[day] = {
            "date": day,
            **day_tokens,
            "tokens": sum(day_tokens.values()),
            # Partial rather than silently wrong: a day with one unpriced model
            # reports what the rest cost and says the figure is incomplete.
            "costUsd": round(day_cost, 6),
            "complete": day_priced,
            "models": models_out,
        }

    all_time_cost = 0.0
    all_time_complete = True
    models_out = {}
    for model in sorted(all_time_models):
        tokens = all_time_models[model]
        model_cost = cost_of(tokens, rates.get(model))
        if model_cost is None:
            all_time_complete = False
        else:
            all_time_cost += model_cost
        models_out[model] = {**tokens, "tokens": sum(tokens.values()), "costUsd": model_cost}

    today = dt.date.today().isoformat()
    return {
        "schemaVersion": SCHEMA_VERSION,
        "agent": AGENT_ID,
        "updatedAt": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "ratesAsOf": rates_as_of,
        "ratesSource": rates_source,
        "today": days.get(today) or {"date": today, **empty(), "tokens": 0, "costUsd": 0.0,
                                     "complete": True, "models": {}},
        "byDay": days,
        "allTime": {
            **all_time,
            "tokens": sum(all_time.values()),
            "costUsd": round(all_time_cost, 6),
            "complete": all_time_complete,
            "activeDays": len(days),
            "models": models_out,
        },
        "unratedModels": sorted(unrated),
    }


def write_json(path: Path, payload: Any) -> None:
    """Atomic, because the panel is watching this file and half a JSON
    document reads as a corrupt record rather than as a slow one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent,
                                         prefix=f".{path.name}.", delete=False)
    try:
        with handle:
            json.dump(payload, handle, indent=2, sort_keys=False)
            handle.write("\n")
        os.replace(handle.name, path)
    except BaseException:
        try:
            os.unlink(handle.name)
        except OSError:
            pass
        raise


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True, description="Rate Claude Code transcripts into dollars.")
    parser.add_argument("--print", dest="to_stdout", action="store_true", help="dump the record, write nothing")
    parser.add_argument("--update-rates", action="store_true", help="refresh the rate table from LiteLLM")
    parser.add_argument("--rates", action="store_true", help="show the rate table in use")
    args = parser.parse_args()

    if args.update_rates:
        return update_rates()

    rates, source, as_of = load_rates()

    if args.rates:
        print(f"source: {source}\nrates as of: {as_of}\n")
        print(f"{'model':<22} {'input':>8} {'output':>8} {'cache wr':>9} {'cache rd':>9}   (USD per 1M)")
        for model in sorted(rates):
            row = rates[model]
            cells = ["  -  " if row.get(c) is None else f"{row[c]:.3f}" for c in CATEGORIES]
            print(f"{model:<22} {cells[0]:>8} {cells[1]:>8} {cells[2]:>9} {cells[3]:>9}")
        return 0

    record = build_record(scan(), rates, source, as_of)

    if args.to_stdout:
        json.dump(record, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    path = state_dir() / f"{AGENT_ID}.json"
    write_json(path, record)
    today = record["today"]
    print(f"token-cost: {path}")
    print(f"  today     {today['tokens']:>14,} tokens   ${today['costUsd']:,.2f}"
          + ("" if today["complete"] else "   (incomplete: unpriced models)"))
    print(f"  all time  {record['allTime']['tokens']:>14,} tokens   ${record['allTime']['costUsd']:,.2f}"
          f"   over {record['allTime']['activeDays']} days")
    if record["unratedModels"]:
        print(f"  unpriced: {', '.join(record['unratedModels'])}  (add rates with --update-rates)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
